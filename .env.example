# local = Ollama habilitado + BYOK opcional | hosted = solo BYOK
MODE=local
DB_URL=sqlite:///./data/truetinfoilhat.db
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
# Modelo Claude por defecto (BYOK; la key la manda el navegador por request)
ANTHROPIC_DEFAULT_MODEL=claude-haiku-5-5
# Años hacia atrás para comparar con Wayback Machine
WAYBACK_YEARS_BACK=1
CORS_ORIGINS=http://localhost:5173
OLLAMA_THINK=false
OLLAMA_TIMEOUT=600
